# Copie ce fichier en .env.local pour tester en local avec `vercel dev`
# (ou récupère les vraies valeurs avec `vercel env pull .env.local`).

# Mot de passe de la page /admin (à choisir, long et unique)
ADMIN_PASSWORD=change-moi

# Ajouté automatiquement quand tu connectes un store Vercel Blob au projet
BLOB_READ_WRITE_TOKEN=

# Ajoutés automatiquement quand tu connectes Upstash Redis (Marketplace Vercel)
KV_REST_API_URL=
KV_REST_API_TOKEN=
